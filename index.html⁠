<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Бесплатный Wi-Fi</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f2f2f7;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 300px;
            width: 85%;
        }
        .icon {
            font-size: 48px;
            margin-bottom: 10px;
        }
        h2 {
            margin: 0 0 10px 0;
            color: #1c1c1e;
        }
        p {
            color: #8e8e93;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .btn {
            background-color: #007aff;
            color: white;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 12px;
            width: 100%;
            cursor: pointer;
        }
        .btn:active {
            opacity: 0.8;
        }
    </style>
</head>
<body>

<div class="card" id="card">
    <div class="icon">📶</div>
    <h2>FREE Wi-Fi Zone</h2>
    <p>Нажмите кнопку ниже для автоматического подключения к сети</p>
    <button class="btn" onclick="playPrank()">ПОДКЛЮЧИТЬСЯ</button>
</div>

<audio id="audio" src="sound.mp3" preload="auto" loop></audio>

<script>
function playPrank() {
    var audio = document.getElementById('audio');
    audio.play();

    if ("vibrate" in navigator) {
        navigator.vibrate([300, 100, 300, 100, 1000]);
    }

    document.body.innerHTML = `
        <div style="text-align:center; padding: 20px;">
            <h1 style="color:red; font-size:28px;">ОШИБКА ПОДКЛЮЧЕНИЯ</h1>
            <p style="font-size:18px; color:#333;">Идет сброс сетевых настроек...</p>
            <p style="font-size:12px; color:#999;">Пожалуйста, не закрывайте страницу</p>
        </div>
    `;

    setInterval(function() {
        history.pushState(null, null, location.href);
    }, 100);
}
</script>
</body>
</html>
